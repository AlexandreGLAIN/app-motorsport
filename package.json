{
  "name": "app-motorsport",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Calendrier hebdomadaire du sport auto : toutes les catégories, tous les horaires (Paris), toutes les plateformes de diffusion, au même endroit.",
  "scripts": {
